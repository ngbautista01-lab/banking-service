        {
          "name": "Create Client",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = String(Date.now()).slice(-9);",
                  "const uniqueDocumentNumber = suffix.padStart(9, '1');",
                  "const uniqueEmail = `ana.perez+${Date.now()}@example.com`;",
                  "pm.collectionVariables.set('uniqueDocumentNumber', uniqueDocumentNumber);",
                  "pm.collectionVariables.set('uniqueEmail', uniqueEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test('mutation returned no GraphQL errors', function () {",
                  "  pm.expect(response.errors, JSON.stringify(response.errors || [])).to.be.undefined;",
                  "  pm.expect(response.data).to.not.be.null;",
                  "  pm.expect(response.data.createClient).to.exist;",
                  "});",
                  "",
                  "pm.test('client was created', function () {",
                  "  pm.expect(response.data.createClient.id).to.be.a('string');",
                  "  pm.expect(response.data.createClient.email).to.eql(pm.collectionVariables.get('uniqueEmail'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('clientId', response.data.createClient.id);",
                  "pm.variables.set('clientId', response.data.createClient.id);",
                  "if (pm.environment) {",
                  "  pm.environment.set('clientId', response.data.createClient.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation CreateClient($input: CreateClientInput!) { createClient(input: $input) { id firstName lastName documentNumber email phone status createdAt updatedAt } }\",\n  \"variables\": {\n    \"input\": {\n      \"firstName\": \"Ana\",\n      \"lastName\": \"Perez\",\n      \"documentNumber\": \"{{uniqueDocumentNumber}}\",\n      \"email\": \"{{uniqueEmail}}\",\n      \"phone\": \"8095550101\",\n      \"status\": \"ACTIVE\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/graphql"
