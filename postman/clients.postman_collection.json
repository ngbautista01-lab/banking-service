{
  "info": {
    "_postman_id": "4f4d8e9f-7044-4e95-bd40-8f4113d3df11",
    "name": "Banking Service - Clients",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Client",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('client was created', function () {",
              "  pm.expect(response.data.createClient.id).to.be.a('string');",
              "  pm.expect(response.data.createClient.email).to.eql('ana.perez@example.com');",
              "});",
              "",
              "pm.environment.set('clientId', response.data.createClient.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"mutation CreateClient($input: CreateClientInput!) { createClient(input: $input) { id firstName lastName documentNumber email phone status createdAt updatedAt } }\",\n  \"variables\": {\n    \"input\": {\n      \"firstName\": \"Ana\",\n      \"lastName\": \"Perez\",\n      \"documentNumber\": \"001-1234567-8\",\n      \"email\": \"ana.perez@example.com\",\n      \"phone\": \"8095550101\",\n      \"status\": \"ACTIVE\"\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      }
    },
    {
      "name": "List Clients",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('clients array exists', function () {",
              "  pm.expect(response.data.clients).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query { clients { id firstName lastName documentNumber email phone status createdAt updatedAt } }\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      }
    },
    {
      "name": "Get Client By Id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('returned client matches environment id', function () {",
              "  pm.expect(response.data.client.id).to.eql(pm.environment.get('clientId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query Client($id: String!) { client(id: $id) { id firstName lastName documentNumber email phone status createdAt updatedAt } }\",\n  \"variables\": {\n    \"id\": \"{{clientId}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      }
    },
    {
      "name": "Search Clients",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('search returns an array', function () {",
              "  pm.expect(response.data.searchClients).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query SearchClients($input: SearchClientsInput!) { searchClients(input: $input) { id firstName lastName documentNumber email phone status createdAt updatedAt } }\",\n  \"variables\": {\n    \"input\": {\n      \"term\": \"ana\"\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
